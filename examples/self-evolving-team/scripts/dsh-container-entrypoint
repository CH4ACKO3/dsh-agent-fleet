#!/bin/sh
set -eu

profile_dir="$DSH_HOME/profiles/web"
ready_file="$profile_dir/.fleet-container-ready"
revision_file="$profile_dir/.fleet-container-revision"
profile_revision="$FLEET_SOURCE_COMMIT:memorax-render-v1-turn-fold-0.6.0-patchouli-0.1.6"

mkdir -p "$DSH_HOME" /workspace /data/.patchouli
chmod 0700 /data/.patchouli

if [ ! -f "$DSH_HOME/node_modules/dsh-harmony-bootstrap/installation.json" ]; then
  echo "[container] Installing Harmony launcher into the persistent DSH home..."
  npm_config_global=true \
    npm_config_prefix=/usr/local \
    node /usr/local/lib/node_modules/dsh-harmony/scripts/postinstall.cjs
fi

if [ ! -f "$ready_file" ]; then
  echo "[container] Initializing DeepSeek Harness web profile..."
  dsh plugin --profile web install

  cat > "$profile_dir/pnpm-workspace.yaml" <<'YAML'
packages:
  - .

nodeLinker: hoisted
autoInstallPeers: false

allowBuilds:
  dsh-harmony: true
YAML

  touch "$ready_file"
fi

installed_revision=""
if [ -f "$revision_file" ]; then
  installed_revision="$(cat "$revision_file")"
fi

if [ "$installed_revision" != "$profile_revision" ]; then
  echo "[container] Installing Fleet, Patchouli, and model runtime dependencies..."
  for dependency in dsh-agent-fleet dsh-agent-fleet-patchouli dsh-patchouli dsh-patchouli-native-context-service dsh-llm-memorax; do
    if grep -q "\"$dependency\"" "$profile_dir/package.json"; then
      pnpm --dir "$profile_dir" remove "$dependency"
    fi
  done
  pnpm --dir "$profile_dir" add --force \
    "dsh-harmony@0.8.10" \
    "the-binding-of-dsh@0.1.7" \
    "/opt/dsh/plugins/dsh-agent-fleet.tgz" \
    "/opt/dsh/plugins/dsh-agent-fleet-patchouli.tgz" \
    "dsh-patchouli@0.1.6" \
    "dsh-patchouli-native-context-service@0.1.6" \
    "/opt/dsh/plugins/dsh-llm-memorax-0.1.0.tgz" \
    "@ch4acko3/dsh-turn-fold@0.6.0" \
    "@ch4acko3/dsh-shiki@0.1.2" \
    "@ch4acko3/dsh-syntax-highlight@0.1.1" \
    "@ch4acko3/dsh-code-render@0.1.2" \
    "@ch4acko3/dsh-markdown-render@0.1.2" \
    "@ch4acko3/dsh-mermaid-render@0.1.1" \
    "@ch4acko3/dsh-math-render@0.1.1" \
    "@ch4acko3/dsh-structured-render@0.1.2" \
    "@ch4acko3/dsh-table-render@0.1.2" \
    "@ch4acko3/dsh-code-frame-render@0.1.2" \
    "@ch4acko3/dsh-diff-engine@0.1.2" \
    "@ch4acko3/dsh-diff-render@0.1.3" \
    "@ch4acko3/dsh-ansi-render@0.1.2"

  node /opt/dsh/configure-profile.mjs \
    "$profile_dir/package.json" \
    "$profile_dir/cordis.patch.yml"
  printf '%s\n' "$profile_revision" > "$revision_file"
  echo "[container] Fleet, Patchouli, and model profile updated."
fi

: "${DEEPSEEK_FLASH_API_KEY:?DEEPSEEK_FLASH_API_KEY is required for the model provider}"
MEMORAX_BRIDGE_PORT="${MEMORAX_BRIDGE_PORT:-3082}" \
  node "$profile_dir/node_modules/dsh-llm-memorax/bin/local-tls-bridge.mjs" &

node /opt/dsh/tcp-proxy.mjs &

exec dsh web \
  --host 127.0.0.1 \
  --port "$DSH_PORT" \
  --no-open \
  --trusted-host "$DSH_TRUSTED_HOST" "$DSH_TRUSTED_HOST_ALT"
