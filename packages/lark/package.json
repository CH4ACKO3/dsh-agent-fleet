{
  "name": "@ch4acko3/dsh-agent-fleet-lark",
  "version": "0.1.0",
  "description": "Lark and Feishu connector for Agent Fleet Gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CH4ACKO3/dsh-agent-fleet.git",
    "directory": "packages/lark"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter dsh-agent-fleet build:host && tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Agent Fleet Lark",
        "zh-CN": "Agent Fleet 飞书"
      },
      "summary": {
        "en": "Connect Lark and Feishu to Agent Fleet through Fleet Gateway.",
        "zh-CN": "通过 Fleet Gateway 将飞书和 Lark 接入 Agent Fleet。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.1.6-0",
    "dsh-agent-fleet": "^0.1.0"
  },
  "dependencies": {
    "@larksuite/channel": "^0.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "dsh-agent-fleet": "workspace:*",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
