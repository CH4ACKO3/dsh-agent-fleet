{
  "name": "@ch4acko3/dsh-agent-fleet-permissions",
  "version": "0.1.0",
  "description": "Dynamic permission groups and capability namespaces for Agent Fleet",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter dsh-agent-fleet build:host && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Agent Fleet Permissions",
        "zh-CN": "Agent Fleet 权限组"
      },
      "summary": {
        "en": "Optional dynamic groups, presets, OP, and namespaced permissions for Fleet Teams.",
        "zh-CN": "为 Fleet Team 提供可选的动态权限组、预设、OP 与命名空间权限。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "dsh-agent-fleet": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.1.2-0",
    "@types/node": "^22.20.0",
    "dsh-agent-fleet": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
