{
  "name": "@ch4acko3/dsh-agent-fleet-git",
  "version": "0.1.0",
  "description": "Fleet-aware Git scope checking, worktree service, and read-only graph for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CH4ACKO3/dsh-agent-fleet.git",
    "directory": "packages/git"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter dsh-agent-fleet build:host && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Agent Fleet Git",
        "zh-CN": "Agent Fleet Git"
      },
      "summary": {
        "en": "Git scope checks, member worktrees, diffs, and a read-only graph for Fleet.",
        "zh-CN": "面向 Fleet 的 Git 范围检查、成员工作树、Diff 与只读图谱。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "dsh-agent-fleet"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "simple-icons": "^16.28.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.5-rc.2 <0.1.6-0",
    "dsh-agent-fleet": "^0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "dsh-agent-fleet": "workspace:*",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
