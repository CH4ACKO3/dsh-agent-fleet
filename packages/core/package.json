{
  "name": "@dsh-agent-fleet/core",
  "version": "0.1.0",
  "private": true,
  "description": "Process-local agent registry and control for DSH Agent Fleet",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./names": {
      "types": "./lib/names.d.ts",
      "default": "./lib/names.js"
    },
    "./activation": {
      "types": "./lib/activation.d.ts",
      "default": "./lib/activation.js"
    },
    "./web": {
      "types": "./lib/web.d.ts",
      "default": "./lib/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "human-names": "^1.0.13",
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
