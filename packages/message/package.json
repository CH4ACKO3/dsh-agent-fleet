{
  "name": "@dsh-agent-fleet/message",
  "version": "0.1.0",
  "private": true,
  "description": "Process-local messaging and coordination tools for DSH Agent Fleet",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.1.6-0"
  },
  "license": "MIT"
}
