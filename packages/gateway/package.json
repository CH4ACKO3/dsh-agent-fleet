{
  "name": "@ch4acko3/dsh-agent-fleet-gateway",
  "version": "0.1.0",
  "description": "External connector gateway for Agent Fleet",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @dsh-agent-fleet/core build && pnpm --filter @dsh-agent-fleet/message build && pnpm --filter @dsh-agent-fleet/resources build && pnpm --filter dsh-agent-fleet build:host && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Agent Fleet Gateway",
        "zh-CN": "Agent Fleet 外部网关"
      },
      "summary": {
        "en": "External protocol and connector gateway for Fleet Mailbox.",
        "zh-CN": "面向 Fleet Mailbox 的外部协议与连接器网关。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-agent-fleet": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "dsh-agent-fleet": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
