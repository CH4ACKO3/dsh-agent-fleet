{
  "name": "dsh-agent-fleet-patchouli",
  "version": "0.1.4",
  "description": "Patchouli memory integration for DSH Agent Fleet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CH4ACKO3/dsh-agent-fleet.git",
    "directory": "packages/dsh-fleet-patchouli"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./adapter": {
      "types": "./lib/adapter.d.ts",
      "default": "./lib/adapter.js"
    },
    "./processor": {
      "types": "./lib/processor.d.ts",
      "default": "./lib/processor.js"
    },
    "./history-search": {
      "types": "./lib/history-search.d.ts",
      "default": "./lib/history-search.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @dsh-agent-fleet/message build && pnpm --filter dsh-agent-fleet build:host && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Fleet Patchouli",
        "zh-CN": "Fleet Patchouli 记忆"
      },
      "summary": {
        "en": "Scoped historical recall for long-running Agent Fleet teams.",
        "zh-CN": "为长运行 Agent Fleet 团队提供按可见范围隔离的历史召回。"
      },
      "category": "runtime"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "dsh-agent-fleet"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-agent-fleet": "^0.2.0",
    "dsh-patchouli": "^0.1.3",
    "dsh-patchouli-native-context-service": "^0.1.4",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "dsh-agent-fleet": "workspace:*",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
