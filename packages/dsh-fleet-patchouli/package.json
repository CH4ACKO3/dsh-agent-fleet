{
  "name": "dsh-fleet-patchouli",
  "version": "0.1.0",
  "description": "Patchouli memory integration for DSH Agent Fleet",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./adapter": {
      "types": "./lib/adapter.d.ts",
      "default": "./lib/adapter.js"
    },
    "./processor": {
      "types": "./lib/processor.d.ts",
      "default": "./lib/processor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @dsh-agent-fleet/message build && pnpm --filter dsh-agent-fleet build:host && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Fleet Patchouli",
        "zh-CN": "Fleet Patchouli 记忆"
      },
      "summary": {
        "en": "Scoped historical recall for long-running Agent Fleet teams.",
        "zh-CN": "为长运行 Agent Fleet 团队提供按可见范围隔离的历史召回。"
      },
      "category": "runtime"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || >=0.1.1-rc.1 <0.1.2-0",
    "dsh-agent-fleet": "^0.1.0",
    "dsh-patchouli": "^0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1 <0.1.2-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.1.2-0",
    "@types/node": "^22.20.0",
    "dsh-agent-fleet": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
